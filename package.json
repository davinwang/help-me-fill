{
  "name": "help-me-fill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
