    "fixtures:serve": "vite --config tests/fixtures/vite.config.ts --host 127.0.0.1",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "mammoth": "^1.12.3",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "docx": "^9.7.1",
    "jsdom": "30.1.1",
    "pdf-lib": "1.17.1",
    "terser": "^5.36.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue": "3.5.22"
  }
